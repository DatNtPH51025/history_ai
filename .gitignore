gitignore
# File chứa các biến môi trường và thông tin nhạy cảm.
# RẤT QUAN TRỌNG: Luôn bỏ qua file .env
.env
*.env

# File hệ điều hành.
# Operating system files.
.DS_Store
Thumbs.db
Desktop.ini

# File cấu hình của các IDE (tránh xung đột cài đặt cá nhân).
# IDE configuration files.
.idea/
.vscode/
*.iml
*.ipr
*.iws

# File log và file tạm.
# Log files and temporary files.
*.log
*.class
*.pyc
*.swp
*.tmp
*.zip

# File và thư mục được tạo bởi các công cụ của Dart/Flutter.
# These are files and directories created by the Dart/Flutter tools.
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
app.*.symbols
app.*.map.json

# Các thư mục build của từng nền tảng cụ thể
# Platform-specific build artifacts.
/ios/.symlinks/
/ios/Flutter/
/android/.gradle/
/android/app/build/
/android/build/
/android/key.properties
/windows/flutter/ephemeral
/windows/flutter/ephemeral.plugin_symlinks
/windows/runner/Debug/
/windows/runner/Profile/
/windows/runner/Release/
/linux/flutter/ephemeral
/linux/flutter/ephemeral.plugin_symlinks
/linux/build/
/macos/Flutter/ephemeral
/macos/Flutter/ephemeral.plugin_symlinks
/macos/build/

